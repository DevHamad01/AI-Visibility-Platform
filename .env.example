# ==============================================================================
# AI Visibility Platform — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# only this `.env.example` is committed. Never commit real API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (Postgres). Not published on the host — only reachable on the
# internal docker compose network as the `db` service.
# ------------------------------------------------------------------------------
POSTGRES_USER=aivisibility
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aivisibility
# Used by the api/worker containers. Host name `db` is the compose service name.
DATABASE_URL=postgresql+psycopg://aivisibility:change-me-locally@db:5432/aivisibility

# ------------------------------------------------------------------------------
# Redis (RQ job queue + rate limiting). Not published on the host — only
# reachable on the internal docker compose network as the `redis` service.
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# DataForSEO (https://dataforseo.com/) — live SERP/keyword/LLM-mentions data.
# Basic auth credentials from your DataForSEO dashboard.
# DATAFORSEO_BASE_URL defaults to the real, billed API — required by the
# brief ("live data by default"). For routine local development against a
# small trial balance, you may point this at DataForSEO's free Sandbox
# instead (same request/response shapes, dummy data, never billed):
#   DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com
# Never use the sandbox for the live smoke test or the final demo — it does
# not return real data or a real account balance.
# ------------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Hard cap on estimated + actual DataForSEO spend per pipeline run (USD).
# A call whose estimated cost would exceed the remaining budget is never
# made; the run ends `partial` instead. Sized for a small trial balance that
# must survive both development and the final demo.
DATAFORSEO_MAX_COST_PER_RUN=0.15

# ------------------------------------------------------------------------------
# LLM provider chain. Comma-separated ordered fallback list of `provider:model`.
# The pipeline tries each entry in order; if one exhausts retries, has an open
# circuit, or returns a non-retryable error, it falls through to the next.
# Supported providers: openai, anthropic, groq, gemini (groq/gemini are called
# through their OpenAI-compatible base URLs via the openai SDK).
# Default dev chain uses free tiers: Groq (OpenAI's open-weight gpt-oss-120b)
# primary, Gemini flash-lite as fallback. OpenAI/Anthropic are first-class and
# can be swapped in purely via this env var — no code changes.
# Model ids verified live against each provider's docs on 2026-11-10:
# gemini-2.5-flash is deprecated (Google auto-routes it to gemini-3.5-flash-lite
# from Dec 1, 2026) — use gemini-3.5-flash-lite directly instead.
# If a provider's API key below is empty, that entry is skipped automatically
# (e.g. the chain still works with Groq alone if GEMINI_API_KEY is empty).
# ------------------------------------------------------------------------------
LLM_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# HTTP client timeouts (seconds), used for every outbound call (DataForSEO,
# LLM providers).
# ------------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=60
LLM_READ_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Retry / backoff policy (tenacity, exponential backoff + full jitter) applied
# to retryable errors only (timeouts, connection errors, 429, 5xx, DataForSEO
# "try later" inner status codes).
# ------------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=4
RETRY_BACKOFF_BASE_SECONDS=0.5
RETRY_BACKOFF_MAX_SECONDS=20

# ------------------------------------------------------------------------------
# Circuit breaker, one per dependency (dataforseo, llm). Opens after this many
# *consecutive* failures; stays open for the cooldown, then goes half-open.
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ------------------------------------------------------------------------------
# Response cache (api_cache table). Avoids paying twice for the same
# DataForSEO call (same endpoint + canonical payload) within the TTL.
# ------------------------------------------------------------------------------
API_CACHE_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Pipeline budget guards.
# ------------------------------------------------------------------------------
MAX_QUERIES_PER_RUN=12
MAX_SERP_CALLS_PER_RUN=12
RUN_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------------
# Logging / error tracking.
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional. Leave empty to disable Sentry (no-op client).
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Flask app.
# ------------------------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=change-me-locally

# ------------------------------------------------------------------------------
# Frontend (consumed by the Angular build / nginx — see frontend/src/environments).
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
API_PORT=8000
